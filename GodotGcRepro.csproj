<Project Sdk="Godot.NET.Sdk/4.7.2">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<!-- The bug only shows up in fully optimized code, which is what AOT builds are from the start -->
		<PublishAot>true</PublishAot>
	</PropertyGroup>
	<ItemGroup>
		<!-- Godot finds script classes through reflection, so don't let AOT trimming remove them -->
		<TrimmerRootAssembly Include="GodotSharp" />
		<TrimmerRootAssembly Include="$(TargetName)" />
	</ItemGroup>
</Project>
